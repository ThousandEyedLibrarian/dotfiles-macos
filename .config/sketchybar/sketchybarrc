#!/bin/bash

# Wrapper script to start Lua config for sketchybar
cd "$HOME/.config/sketchybar"

# Set Lua path for SbarLua module
export LUA_CPATH="$HOME/.local/share/sketchybar_lua/?.so"

# Run Lua config (exec replaces shell, keeping event loop alive)
exec /opt/homebrew/opt/lua@5.4/bin/lua-5.4 init.lua
